# ---------------------------------------------------------------------------
# FluxCast environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored — never commit
# real credentials.
#
# Nothing here is required to run FluxCast locally. With no values set, the app
# runs in development mode: in-memory sample data and clearly-labelled
# placeholder stream credentials. Fill in a section to switch that part on.
#
# Every variable below is read on the SERVER at RUNTIME. None of them are
# exposed to the browser, so none need a NEXT_PUBLIC_ prefix — and none should
# have one. See the note at the bottom of this file.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# All three are needed together. When any is missing, FluxCast uses in-memory
# sample data instead of the database.
#
# Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Project Settings -> API Keys -> Publishable key (starts with `sb_publishable_`).
# Not a secret by design: Row Level Security is what protects the data.
SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> Secret key / service_role.
# Bypasses Row Level Security. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit Cloud ---------------------------------------------------------
# All three are needed together. When any is missing, FluxCast generates
# placeholder stream credentials labelled DEVELOPMENT ONLY.
#
# LiveKit Cloud -> Settings -> Project -> WebSocket URL.
# Either wss:// or https:// works; FluxCast converts as needed.
LIVEKIT_URL=

# LiveKit Cloud -> Settings -> API Keys
LIVEKIT_API_KEY=

# Signs listener tokens. Must never reach the browser.
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# A note on NEXT_PUBLIC_
#
# Next.js replaces `process.env.NEXT_PUBLIC_*` with a literal string at BUILD
# time and ships it to browsers. Plain names like the ones above are read at
# RUNTIME on the server only.
#
# Runtime reads are what you want here: if a host withholds a variable from the
# build step (Vercel does this for variables typed as secrets), a NEXT_PUBLIC_
# value bakes in empty and the site silently falls back to sample data.
#
# For compatibility, FluxCast also accepts NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if they are already set — some hosting
# integrations create them automatically. The plain names take precedence.
# ---------------------------------------------------------------------------
